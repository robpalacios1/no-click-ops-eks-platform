# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and user credentials. It is not recommended to trace
# them. Only public vars should be template or added with a suffix ".example"
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and should not be tracked
*override.tf
*override.tf.json
*_override.tf
*_override.tf.json

# CLI config files
.terraformrc
terraform.rc

# VS Code settings
.vscode/

# OS generated files
.DS_Store
Thumbs.db
